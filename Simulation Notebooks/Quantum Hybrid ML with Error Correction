        "## QFT and Variational Circuit Definition\n",
        "\n",
        "This cell defines the legitimate quantum evolution: input encoding, QFT, trainable rotations, entanglement, and layer-wise circuit prefixes.\n",
        "\n",
        "For the clean branch,\n",
        "\n",
        "$$\n",
        "|\\psi_l^{\\mathrm{ideal}}\\rangle\n",
        "=\n",
        "U_lU_{l-1}\\cdots U_1U_{\\mathrm{QFT}}U_{\\mathrm{enc}}|0\\rangle.\n",
        "$$\n",
        "\n",
        "For the noisy branch,\n",
        "\n",
        "$$\n",
        "|\\psi_l^{\\mathrm{noisy}}\\rangle\n",
        "=\n",
        "E_lU_l\\cdots E_2U_2E_1U_1U_{\\mathrm{QFT}}U_{\\mathrm{enc}}|0\\rangle.\n",
        "$$\n",
        "\n",
        "Thus, legitimate QFT/variational evolution is part of the expected trajectory and is not itself classified as error."
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# =====================================================================\n",
        "# 5. QFT + VARIATIONAL CIRCUIT\n",
        "# =====================================================================\n",
        "\n",
        "def build_qft_variational_circuit(\n",
        "    params,\n",
        "    sample_input,\n",
        "    n_completed_layers,\n",
        "    differentials=None,\n",
        "    lr_correction=0.10,\n",
        "    apply_correction=False\n",
        "):\n",
        "\n",
        "    # ---------------------------------------------------------------\n",
        "    # INPUT ENCODING\n",
        "    # ---------------------------------------------------------------\n",
        "\n",
        "    for q in range(n_qubits):\n",
        "\n",
        "        qml.RX(\n",
        "            sample_input[q],\n",
        "            wires=q\n",
        "        )\n",
        "\n",
        "    # ---------------------------------------------------------------\n",
        "    # QFT\n",
        "    # ---------------------------------------------------------------\n",
        "\n",
        "    qml.QFT(\n",
        "        wires=range(n_qubits)\n",
        "    )\n",
        "\n",
        "    # ---------------------------------------------------------------\n",
        "    # VARIATIONAL LAYERS\n",
        "    # ---------------------------------------------------------------\n",
        "\n",
        "    for layer_idx in range(\n",
        "        n_completed_layers\n",
        "    ):\n",
        "\n",
        "        # -----------------------------------------------------------\n",
        "        # NEGATIVE XYZ FEEDBACK\n",
        "        # -----------------------------------------------------------\n",
        "\n",
        "        if (\n",
        "            apply_correction\n",
        "            and\n",
        "            differentials is not None\n",
        "            and\n",
        "            layer_idx > 0\n",
        "        ):\n",
        "\n",
        "            previous_delta = (\n",
        "                differentials[\n",
        "                    layer_idx - 1\n",
        "                ]\n",
        "            )\n",
        "\n",
        "            for q in range(n_qubits):\n",
        "\n",
        "                qml.RX(\n",
        "                    -lr_correction\n",
        "                    * previous_delta[0, q],\n",
        "                    wires=q\n",
        "                )\n",
        "\n",
        "                qml.RY(\n",
        "                    -lr_correction\n",
        "                    * previous_delta[1, q],\n",
        "                    wires=q\n",
        "                )\n",
        "\n",
        "                qml.RZ(\n",
        "                    -lr_correction\n",
        "                    * previous_delta[2, q],\n",
        "                    wires=q\n",
        "                )\n",
        "\n",
        "        # -----------------------------------------------------------\n",
        "        # TRAINABLE RY / RZ\n",
        "        # -----------------------------------------------------------\n",
        "\n",
        "        layer_params = get_layer_params(\n",
        "            params,\n",
        "            layer_idx\n",
        "        )\n",
        "\n",
        "        for q in range(n_qubits):\n",
        "\n",
        "            qml.RY(\n",
        "                layer_params[2 * q],\n",
        "                wires=q\n",
        "            )\n",
        "\n",
        "            qml.RZ(\n",
        "                layer_params[2 * q + 1],\n",
        "                wires=q\n",
        "            )\n",
        "\n",
        "        # -----------------------------------------------------------\n",
        "        # RING ENTANGLEMENT\n",
        "        # -----------------------------------------------------------\n",
        "\n",
        "        for q in range(\n",
        "            n_qubits - 1\n",
        "        ):\n",
        "\n",
        "            qml.CNOT(\n",
        "                wires=[q, q + 1]\n",
        "            )\n",
        "\n",
        "        qml.CNOT(\n",
        "            wires=[\n",
        "                n_qubits - 1,\n",
        "                0\n",
        "            ]\n",
        "        )\n",
        "\n",
        "\n",
        "# =====================================================================\n",
        "# 5B. v15 CONTEXT-PROPAGATING HETEROGENEOUS ERROR CIRCUIT\n",
        "# =====================================================================\n",
        "def build_contextual_noisy_circuit(params, sample_input, n_completed_layers):\n",
        "    \"\"\"Same ideal circuit, with a fixed random coherent error at each (layer,q).\n",
        "\n",
        "    Error placement is deliberately inside the circuit: after the trainable\n",
        "    single-qubit rotations and before the ring CNOTs.  Hence the error is\n",
        "    entangled immediately and every later layer acts on the already-corrupted\n",
        "    state.  No ideal expectation or correction target is consulted here.\n",
        "    \"\"\"\n",
        "    for q in range(n_qubits):\n",
        "        qml.RX(sample_input[q], wires=q)\n",
        "    qml.QFT(wires=range(n_qubits))\n",
        "    for layer_idx in range(n_completed_layers):\n",
        "        layer_params = get_layer_params(params, layer_idx)\n",
        "        for q in range(n_qubits):\n",
        "            qml.RY(layer_params[2*q], wires=q)\n",
        "            qml.RZ(layer_params[2*q+1], wires=q)\n",
        "            # heterogeneous static hardware-like coherent over-rotation\n",
        "            qml.RX(float(CONTEXT_RX_ERROR[layer_idx, q]), wires=q)\n",
        "            qml.RY(float(CONTEXT_RY_ERROR[layer_idx, q]), wires=q)\n",
        "            qml.RZ(float(CONTEXT_RZ_ERROR[layer_idx, q]), wires=q)\n",
        "        for q in range(n_qubits-1):\n",
        "            qml.CNOT(wires=[q, q+1])\n",
        "        qml.CNOT(wires=[n_qubits-1, 0])\n",
        "\n",
        "@qml.qnode(quantum_dev, interface=\"torch\", diff_method=None)\n",
        "def contextual_noisy_xyz_qnode(params, sample_input, n_completed_layers):\n",
        "    build_contextual_noisy_circuit(params, sample_input, n_completed_layers)\n",
        "    return ([qml.expval(qml.PauliX(q)) for q in range(n_qubits)] +\n",
        "            [qml.expval(qml.PauliY(q)) for q in range(n_qubits)] +\n",
        "            [qml.expval(qml.PauliZ(q)) for q in range(n_qubits)])\n",
        "\n",
        "@qml.qnode(quantum_shot_dev, interface=\"torch\", diff_method=None)\n",
        "def contextual_noisy_1shot_xyz_qnode(params, sample_input, n_completed_layers):\n",
        "    build_contextual_noisy_circuit(params, sample_input, n_completed_layers)\n",
        "    return ([qml.expval(qml.PauliX(q)) for q in range(n_qubits)] +\n",
        "            [qml.expval(qml.PauliY(q)) for q in range(n_qubits)] +\n",
        "            [qml.expval(qml.PauliZ(q)) for q in range(n_qubits)])"
