        "# =====================================================================\n",
        "# 0. GLOBAL SETTINGS\n",
        "# =====================================================================\n",
        "\n",
        "warnings.filterwarnings(\"ignore\")\n",
        "\n",
        "SEED = 42\n",
        "\n",
        "torch.manual_seed(SEED)\n",
        "np.random.seed(SEED)\n",
        "\n",
        "if torch.cuda.is_available():\n",
        "    torch.cuda.manual_seed_all(SEED)\n",
        "\n",
        "\n",
        "n_qubits = 15\n",
        "n_layers = 15\n",
        "\n",
        "# ---------------------------------------------------------------\n",
        "# BATCH SIZE & PARAMETERS\n",
        "# ---------------------------------------------------------------\n",
        "\n",
        "BATCH_SIZE = 64\n",
        "\n",
        "EPOCHS = 5\n",
        "\n",
        "LEARNING_RATE = 0.001\n",
        "\n",
        "# Training/generalization controls. Scheduler never reads test metrics.\n",
        "LR_SCHEDULER_ETA_MIN = 1e-4\n",
        "\n",
        "LR_CORRECTION = 0.10\n",
        "\n",
        "# Backward-side residual regularization. One physical/simulated shot per axis\n",
        "# remains fixed; repeated training observations are stabilized with EMA.\n",
        "CORRECTION_LOSS_WEIGHT = 0.02  # retained for surrogate/audit compatibility; gradient is normalized below\n",
        "# Target correction-gradient magnitude relative to the task gradient.\n",
        "# rho=0.10 means the applied correction branch has ||g_corr|| ~= 10% of ||g_task||\n",
        "# whenever a usable correction direction exists.\n",
        "CORRECTION_GRAD_RATIO = 0.0  # v14.1 no-noise contextual baseline: no artificial correction gradient\n",
        "GRAD_NORM_EPS = 1e-12\n",
        "PROJECT_NEGATIVE_GRAD_CONFLICT = True\n",
        "AUDIT_CORRELATIONS = True\n",
        "AUDIT_SAME_SAMPLE_PRE_POST = False  # v17 removed: stale-target legacy audit\n",
        "AUDIT_COUNTERFACTUAL_GRADIENT_STEPS = False  # v17 removed: stale-target legacy audit\n",
        "AUDIT_THEORETICAL_SHOT_VARIANCE = True\n",
        "\n",
        "# Controlled synthetic hardware-error benchmark. These are deliberately\n",
        "# explicit and reproducible so correction efficacy can be measured against a\n",
        "# known clean expectation. This is a measurement-level noise harness, not a\n",
        "# claim of full device physics.\n",
        "INJECT_CONTROLLED_NOISE = True\n",
        "# v15: fixed heterogeneous coherent hardware-error map.  A distinct RX/RY/RZ\n",
        "# over-rotation is drawn once for every (layer, qubit), then inserted INSIDE\n",
        "# the circuit before that layer's ring entangler.  Therefore an error created\n",
        "# at layer l changes the state entering l+1..L and propagates contextually.\n",
        "CONTEXTUAL_RANDOM_NOISE = True\n",
        "RANDOM_NOISE_SEED = SEED + 15015\n",
        "RANDOM_RX_ERROR_RANGE = (-0.060, 0.060)  # radians\n",
        "RANDOM_RY_ERROR_RANGE = (-0.080, 0.080)  # radians\n",
        "RANDOM_RZ_ERROR_RANGE = (-0.060, 0.060)  # radians\n",
        "_rng_context_noise = np.random.default_rng(RANDOM_NOISE_SEED)\n",
        "CONTEXT_RX_ERROR = _rng_context_noise.uniform(*RANDOM_RX_ERROR_RANGE, size=(n_layers, n_qubits))\n",
        "CONTEXT_RY_ERROR = _rng_context_noise.uniform(*RANDOM_RY_ERROR_RANGE, size=(n_layers, n_qubits))\n",
        "CONTEXT_RZ_ERROR = _rng_context_noise.uniform(*RANDOM_RZ_ERROR_RANGE, size=(n_layers, n_qubits))\n",
        "# Legacy expectation-level noise constants retained only because old audit code\n",
        "# references their names. They are NOT used by the v15 contextual noisy QNodes.\n",
        "NOISE_READOUT_FLIP_P = 0.0\n",
        "NOISE_DEPOLARIZING_P = 0.0\n",
        "NOISE_COHERENT_RY_RAD = 0.0\n",
        "\n",
        "# Shot-noise-aware persistent-bias estimator. For ideal one-shot Pauli data,\n",
        "# z=(M-E)/sqrt(1-E^2) has approximately zero mean. Only persistent standardized\n",
        "# residual beyond the EMA noise floor is allowed to drive correction.\n",
        "RESIDUAL_EMA_BETA = 0.95\n",
        "# v6: calibration-probe/component-wise significance detector.\n",
        "CALIBRATION_PROBE_COUNT = 4\n",
        "CALIBRATION_MIN_OBSERVATIONS = 1  # v13: no accumulation gate; retained only for config compatibility\n",
        "# v8: significance uses the analytic Pauli/Bernoulli variance under the clean\n",
        "# QFT-conditioned expectation, never a 2-3-shot empirical variance.\n",
        "BIAS_SIGNIFICANCE_Z_LOW = 1.5\n",
        "BIAS_SIGNIFICANCE_Z_HIGH = 3.0\n",
        "BIAS_ESTIMATE_SHRINKAGE = 0.75\n",
        "# v9: theoretical Pauli sigma floor prevents near-eigenstate E≈±1 components\n",
        "# from producing extreme significance solely because 1-E^2 is tiny.\n",
        "THEORETICAL_SIGMA_FLOOR = 0.10\n",
        "# v9: correction-gradient strength ramps with detector confidence instead of\n",
        "# jumping immediately to CORRECTION_GRAD_RATIO when the gate first opens.\n",
        "CONFIDENCE_ADAPTIVE_GRADIENT = True\n",
        "# Structured pooling: learn a small shared bias model per Pauli axis instead of\n",
        "# 2700 unrelated component biases. QFT displacement is an explicit covariate,\n",
        "# while the clean expectation already contains the full QFT evolution.\n",
        "QFT_AWARE_STRUCTURED_POOLING = True\n",
        "BLIND_SELF_CALIBRATING_MODE = True\n",
        "# Detector must never read NOISE_* or true injected bias. Those exist only in hidden benchmark/evaluator.\n",
        "BLIND_CHANNEL_RIDGE = 1e-2\n",
        "BLIND_CHANNEL_COND_MAX = 1e6\n",
        "QFT_POOL_RIDGE = 1e-3\n",
        "QFT_POOL_MIN_BATCHES = 1  # v13: no accumulation gate; retained only for config compatibility\n",
        "NOISE_ABLATION_MODE = \"combined\"  # zero|readout|depolarizing|coherent|combined\n",
        "USE_PERSISTENT_BIAS_CORRECTION = True\n",
        "# v10 controlled-validation oracle: because injected synthetic noise is known exactly,\n",
        "# remove ONLY that injected expectation-level bias. QFT/data displacement is untouched.\n",
        "# This is an upper-bound/control experiment, not a deployable hardware estimator.\n",
        "ORACLE_INJECTED_ERROR_CORRECTION = False\n",
        "ORACLE_FULL_CONFIDENCE = False\n",
        "ORACLE_APPLY_TO_TRAINING_MEASUREMENT_PATH = False\n",
        "ORACLE_DISABLE_GRADIENT_CORRECTION = False\n",
        "ORACLE_INVARIANT_TOL = 1e-10\n",
        "CORRECTION_HUBER_BETA = 0.25\n",
        "\n",
        "# v7 FAST VALIDATION MODE\n",
        "# The expensive differentiable correction surrogate no longer re-runs all\n",
        "# 4 probes x 15 prefixes (=60 adjoint QNodes) every batch.  Instead it uses\n",
        "# one rotating fixed probe and four depth checkpoints.  A checkpoint at depth\n",
        "# L differentiates through every trainable layer up to L, so the final-depth\n",
        "# checkpoint still exposes all 450 quantum parameters.  The full 4x15\n",
        "# calibration detector remains unchanged, so detection/recovery metrics are\n",
        "# directly comparable with v6; only the gradient estimator is subsampled.\n",
        "FAST_VALIDATION_MODE = True\n",
        "FAST_CORRECTION_PROBES_PER_BATCH = 1\n",
        "FAST_CORRECTION_LAYER_INDICES = (0, 4, 9, 14)  # L01, L05, L10, L15\n",
        "\n",
        "TOTAL_SAMPLES = 512\n",
        "\n",
        "TRAIN_RATIO = 0.80\n",
        "\n",
        "# ---------------------------------------------------------------\n",
        "# OUTPUT / VISUAL FILE SAVING\n",
        "# ---------------------------------------------------------------\n",
        "OUTPUT_ROOT = Path(\"qml_outputs\")\n",
        "OUTPUT_ROOT.mkdir(parents=True, exist_ok=True)\n",
        "FIGURE_DIR = OUTPUT_ROOT / \"figures\"\n",
        "FIGURE_DIR.mkdir(parents=True, exist_ok=True)\n",
        "TRACE_DIR = OUTPUT_ROOT / \"traces\"\n",
        "TRACE_DIR.mkdir(parents=True, exist_ok=True)\n",
        "\n",
        "# Every plt.show() below is automatically saved before the figure closes.\n",
        "_ORIGINAL_PLT_SHOW = plt.show\n",
        "_FIGURE_COUNTER = 0\n",
        "\n",
        "def save_and_close_current_figure(*args, **kwargs):\n",
        "    global _FIGURE_COUNTER\n",
        "    _FIGURE_COUNTER += 1\n",
        "    fig = plt.gcf()\n",
        "    out = FIGURE_DIR / f\"figure_{_FIGURE_COUNTER:04d}.png\"\n",
