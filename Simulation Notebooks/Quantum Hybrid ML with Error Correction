        "def backward_residual_surrogate(params, sample_input, ema_residual):\n",
        "    \"\"\"\n",
        "    Gradient-only backward correction.\n",
        "\n",
        "    The correction residual itself is QFT-conditioned:\n",
        "        C = M(x) - [E_layer(x_ref) + D_QFT(x,x_ref)]\n",
        "\n",
        "    C/EMA is detached. The differentiable carrier is the ACTUAL analytic\n",
        "    expectation E_layer(x), so the optimizer changes the real data-conditioned\n",
        "    circuit parameters rather than differentiating through a one-shot sample.\n",
        "\n",
        "        d/dtheta [(E_actual - stopgrad(E_actual)) * stopgrad(EMA(C))]\n",
        "        = EMA(C) * dE_actual/dtheta\n",
        "\n",
        "    Forward value remains ~0 and no fixed Hamiltonian is inserted as a\n",
        "    forward-state correction gate.\n",
        "    \"\"\"\n",
        "    ema_t = torch.as_tensor(\n",
        "        ema_residual,\n",
        "        dtype=params.dtype,\n",
        "        device=params.device\n",
        "    )\n",
        "\n",
        "    terms = []\n",
        "    dummy = np.zeros((n_layers, 3, n_qubits), dtype=np.float64)\n",
        "\n",
        "    for layer_idx in range(n_layers):\n",
        "        result = analytic_expected_xyz_qnode(\n",
        "            params,\n",
        "            sample_input,\n",
        "            layer_idx + 1,\n",
        "            dummy,\n",
        "            0.0,\n",
        "            False\n",
        "        )\n",
        "\n",
        "        if isinstance(result, torch.Tensor):\n",
        "            e_actual = result.reshape(3, n_qubits)\n",
        "        else:\n",
        "            e_actual = torch.stack(list(result)).reshape(3, n_qubits)\n",
        "\n",
        "        centered = e_actual - e_actual.detach()\n",
        "        terms.append((centered * ema_t[layer_idx]).mean())\n",
        "\n",
        "    return torch.stack(terms).mean()"
