        "        n_qubits=n_qubits,\n",
        "        device=torch_device\n",
        "    )\n",
        "\n",
        "    train_size = int(\n",
        "        samples\n",
        "        *\n",
        "        TRAIN_RATIO\n",
        "    )\n",
        "\n",
        "    train_dataset = TensorDataset(\n",
        "        X[:train_size],\n",
        "        y[:train_size]\n",
        "    )\n",
        "\n",
        "    test_dataset = TensorDataset(\n",
        "        X[train_size:],\n",
        "        y[train_size:]\n",
        "    )\n",
        "\n",
        "    train_loader = DataLoader(\n",
        "        train_dataset,\n",
        "        batch_size=batch_size,\n",
        "        shuffle=True\n",
        "    )\n",
        "\n",
        "    test_loader = DataLoader(\n",
        "        test_dataset,\n",
        "        batch_size=batch_size,\n",
        "        shuffle=False\n",
        "    )\n",
        "\n",
        "    for name, value in {\n",
        "        \"Training samples\":\n",
        "            len(train_dataset),\n",
        "\n",
        "        \"Test samples\":\n",
        "            len(test_dataset),\n",
        "\n",
        "        \"Train batches\":\n",
        "            len(train_loader),\n",
        "\n",
        "        \"Test batches\":\n",
        "            len(test_loader),\n",
        "\n",
        "        \"Batch size\":\n",
        "            batch_size\n",
        "    }.items():\n",
        "\n",
        "        print(\n",
        "            f\"[DATA] {name:<20}: {value:,}\",\n",
        "            flush=True\n",
        "        )\n",
        "\n",
        "    # ---------------------------------------------------------------\n",
        "    # MODEL\n",
        "    # ---------------------------------------------------------------\n",
        "\n",
        "    model = EnhancedQMLClassifier(\n",
        "        n_qubits,\n",
        "        n_layers\n",
        "    ).to(\n",
        "        torch_device\n",
        "    )\n",
        "\n",
        "    criterion = nn.CrossEntropyLoss()\n",
        "\n",
        "    optimizer = optim.AdamW(\n",
        "        model.parameters(),\n",
        "        lr=learning_rate,\n",
        "        weight_decay=1e-4\n",
        "    )\n",
        "\n",
        "    # Epoch-driven schedule: test performance cannot influence the LR.\n",
        "    scheduler = optim.lr_scheduler.CosineAnnealingLR(\n",
        "        optimizer, T_max=max(1, epochs), eta_min=LR_SCHEDULER_ETA_MIN\n",
        "    )\n",
        "    print(f\"[TRAIN] LR scheduler          : CosineAnnealingLR(T_max={max(1, epochs)}, eta_min={LR_SCHEDULER_ETA_MIN:g})\", flush=True)\n",
        "    print(\"[TRAIN] Data augmentation     : DISABLED / REMOVED\", flush=True)\n",
        "\n",
        "    total_params = sum(\n",
        "        p.numel()\n",
        "        for p in model.parameters()\n",
        "    )\n",
        "\n",
        "    trainable_params = sum(\n",
        "        p.numel()\n",
        "        for p in model.parameters()\n",
        "        if p.requires_grad\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        f\"[MODEL] Total parameters     : \"\n",
        "        f\"{total_params:,}\",\n",
        "        flush=True\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        f\"[MODEL] Trainable parameters : \"\n",
        "        f\"{trainable_params:,}\",\n",
        "        flush=True\n",
        "    )\n",
        "\n",
        "    # Fixed calibration probes are selected once and remain unchanged. They are\n",
        "    # used only to estimate persistent measurement/device bias, not task labels.\n",
        "    calibration_probes = X[:train_size][:CALIBRATION_PROBE_COUNT].detach().clone()\n",
        "    print(f\"[CALIBRATION] Fixed probes      : {len(calibration_probes)} (unchanged; labels unused)\", flush=True)\n",
        "    print(f\"[CALIBRATION] Significance gate : |Z| {BIAS_SIGNIFICANCE_Z_LOW:.2f}→{BIAS_SIGNIFICANCE_Z_HIGH:.2f} | min observations={CALIBRATION_MIN_OBSERVATIONS}\", flush=True)\n",
        "    if FAST_VALIDATION_MODE:\n",
        "        print(f\"[FAST] Correction gradient : {FAST_CORRECTION_PROBES_PER_BATCH} rotating probe/batch × layers {[i+1 for i in FAST_CORRECTION_LAYER_INDICES]} (full detector unchanged)\", flush=True)\n",
        "\n",
        "    # ---------------------------------------------------------------\n",
        "    # HISTORY\n",
        "    # ---------------------------------------------------------------\n",
        "\n",
        "    history = {\n",
        "\n",
        "        \"loss\": [],\n",
        "\n",
        "        \"accuracy\": [],\n",
        "\n",
        "        \"f1\": [],\n",
        "\n",
        "        \"test_loss\": [],\n",
        "\n",
        "        \"test_accuracy\": [],\n",
        "\n",
        "        \"test_f1\": [],\n",
        "\n",
        "        \"hamiltonian_total\": [],\n",
        "\n",
        "        \"qubit_z\": [\n",
        "            []\n",
        "            for _ in range(n_qubits)\n",
        "        ],\n",
        "\n",
        "        \"epoch_time\": [],\n",
        "\n",
        "        \"trace_time\": []\n",
        "    }\n",
        "\n",
        "    # ---------------------------------------------------------------\n",
        "    # EPOCH LOOP\n",
        "    # ---------------------------------------------------------------\n",
        "\n",
        "    for epoch in range(\n",
        "        1,\n",
        "        epochs + 1\n",
        "    ):\n",
        "\n",
        "        epoch_start = (\n",
        "            time.perf_counter()\n",
        "        )\n",
        "\n",
        "        model.train()\n",
        "\n",
        "        running_loss = 0.0\n",
        "\n",
        "        predictions = []\n",
        "\n",
        "        targets = []\n",
        "\n",
        "        quantum_outputs = []\n",
        "\n",
        "        # Epoch-level correction validation statistics.\n",
        "        epoch_corr_stats = {\n",
        "            \"cos_pre\": [], \"cos_post\": [], \"applied_task_ratio\": [],\n",
        "            \"projection_coeff\": [], \"conflict\": [],\n",
        "            \"marginal_delta_g\": [], \"marginal_helpful\": [],\n",
        "            \"shot_excess_rms\": [],\n",
        "            \"noise_noisy_mae\": [], \"noise_corrected_mae\": [],\n",
        "            \"noise_improvement_pct\": [], \"bias_confidence_mean\": [],\n",
        "            \"bias_active_fraction\": []\n",
        "        }\n",
        "\n",
        "        print(\n",
        "            f\"\\n\"\n",
        "            f\"{'=' * 35} \"\n",
        "            f\"EPOCH {epoch}/{epochs} \"\n",
        "            f\"{'=' * 35}\",\n",
        "            flush=True\n",
        "        )\n",
        "\n",
        "        current_lr = optimizer.param_groups[0][\"lr\"]\n",
        "        print(f\"[LR] Epoch start learning rate : {current_lr:.8f}\", flush=True)\n",
        "\n",
        "        # -----------------------------------------------------------\n",
        "        # BATCH LOOP\n",
        "        # -----------------------------------------------------------\n",
        "\n",
        "        for batch_idx, (\n",
        "            batch_x,\n",
        "            batch_y\n",
        "        ) in enumerate(\n",
        "            train_loader\n",
        "        ):\n",
        "\n",
        "            batch_start = (\n",
        "                time.perf_counter()\n",
        "            )\n",
        "\n",
        "            optimizer.zero_grad(\n",
        "                set_to_none=True\n",
        "            )\n",
        "\n",
        "            print(\n",
        "                f\"\\n[BATCH \"\n",
        "                f\"{batch_idx + 1:04d}/\"\n",
        "                f\"{len(train_loader):04d}] \"\n",
        "                f\"size={len(batch_x)}\",\n",
        "                flush=True\n",
        "            )\n",
        "\n",
        "            # -------------------------------------------------------\n",
        "            # FORWARD — original training inputs, no augmentation\n",
        "            # -------------------------------------------------------\n",
        "            batch_x_clean = batch_x\n",
        "\n",
        "            forward_start = (\n",
        "                time.perf_counter()\n",
        "            )\n",
        "\n",
        "            outputs, q_out = model(\n",
        "                batch_x\n",
        "            )\n",
        "\n",
        "            forward_time = (\n",
        "                time.perf_counter()\n",
        "                -\n",
        "                forward_start\n",
        "            )\n",
        "\n",
        "            print(\n",
        "                f\"    Forward     : \"\n",
        "                f\"{forward_time:.3f}s\",\n",
        "                flush=True\n",
        "            )\n",
        "\n",
        "            # -------------------------------------------------------\n",
        "            # LOSS\n",
        "            # -------------------------------------------------------\n",
        "\n",
        "            loss = criterion(\n",
        "                outputs,\n",
        "                batch_y\n",
        "            )\n",
        "\n",
        "            print(\n",
        "                f\"    Loss        : \"\n",
        "                f\"{loss.item():.6f}\",\n",
        "                flush=True\n",
        "            )\n",
        "\n",
        "            # -------------------------------------------------------\n",
        "            # BACKWARD-SIDE SINGLE-SHOT CORRECTION SIGNAL\n",
        "            # -------------------------------------------------------\n",
        "            # One representative sample per batch keeps the shot budget low.\n",
        "            # shots=1 remains fixed. The EMA accumulates information across\n",
        "            # optimizer steps without increasing shots per circuit execution.\n",
        "            # v6: first update the detector on fixed calibration probes. The\n",
        "            # training-sample audit remains for QFT/trajectory diagnostics only.\n",
        "            probe_control, probe_diag = collect_calibration_probe_control(\n",
        "                model.params, calibration_probes, verbose=True\n",
        "            )\n",
        "            _, _, raw_residual, _legacy_ema_residual, audit_diag = collect_single_shot_residual(\n",
        "                model.params, batch_x[0], verbose=True\n",
        "            )\n",
        "\n",
        "            if ORACLE_INJECTED_ERROR_CORRECTION and ORACLE_DISABLE_GRADIENT_CORRECTION:\n",
        "                # The known injected systematic channel has already been removed\n",
        "                # exactly in the measurement/expectation path. Do not apply a\n",
        "                # second optimizer-side correction for the same error. Keep a\n",
        "                # differentiable zero scalar so the audit/backward code remains valid.\n",
        "                correction_surrogate = model.params.sum() * 0.0\n",
        "            else:\n",
        "                correction_surrogate = backward_probe_bias_surrogate(\n",
        "                    model.params, calibration_probes, probe_control, batch_idx=batch_idx\n",
        "                )\n",
        "            # Make the primary correction-efficacy metrics come from the fixed probes.\n",
        "            audit_diag[\"noisy_mae\"] = probe_diag[\"noisy_mae\"]\n",
        "            audit_diag[\"corrected_mae\"] = probe_diag[\"corrected_mae\"]\n",
        "            audit_diag[\"correction_improvement_pct\"] = probe_diag[\"recovery_pct\"]\n",
        "            audit_diag[\"bias_confidence\"] = np.full((n_layers,3,n_qubits), probe_diag[\"mean_confidence\"], dtype=np.float64)\n",
        "\n",
        "            epoch_corr_stats[\"noise_noisy_mae\"].append(float(audit_diag[\"noisy_mae\"]))\n",
        "            epoch_corr_stats[\"noise_corrected_mae\"].append(float(audit_diag[\"corrected_mae\"]))\n",
        "            epoch_corr_stats[\"noise_improvement_pct\"].append(float(audit_diag[\"correction_improvement_pct\"]))\n",
        "            epoch_corr_stats[\"bias_confidence_mean\"].append(float(np.mean(audit_diag[\"bias_confidence\"])))\n",
        "            epoch_corr_stats[\"bias_active_fraction\"].append(float(np.mean(audit_diag[\"bias_confidence\"] > 0)))\n",
        "\n",
        "            print(\n",
        "                f\"    Corr surrogate : {correction_surrogate.detach().item():+.6e} \"\n",
        "                f\"(gradient-only, weight={CORRECTION_LOSS_WEIGHT})\",\n",
        "                flush=True\n",
        "            )\n",
        "\n",
        "            # -------------------------------------------------------\n",
        "            # AUDITABLE BACKWARD\n",
        "            # -------------------------------------------------------\n",
        "            # Split the backward pass so the notebook reports the task\n",
        "            # gradient and correction gradient independently. The second\n",
        "            # backward accumulates onto the first, giving the same combined\n",
        "            # gradient used by optimizer.step().\n",
        "\n",
        "            backward_start = time.perf_counter()\n",
        "\n",
        "            loss.backward(retain_graph=True)\n",
        "\n",
        "            task_grad = (\n",
        "                model.params.grad.detach().clone()\n",
        "                if model.params.grad is not None\n",
        "                else torch.zeros_like(model.params)\n",
        "            )\n",
        "\n",
        "            task_grad_norm = task_grad.norm().item()\n",
        "\n",
        "            # Clear ONLY the quantum parameter gradient before measuring the\n",
        "            # correction branch. Classical-head task gradients stay intact.\n",
        "            if model.params.grad is not None:\n",
        "                model.params.grad.zero_()\n",
        "\n",
        "            # Obtain the raw correction gradient. CORRECTION_LOSS_WEIGHT is\n",
        "            # retained in this branch so older runs remain directly auditable,\n",
        "            # but its absolute scale is NOT allowed to determine the optimizer\n",
        "            # influence: the gradient is normalized relative to the task gradient.\n",
        "            weighted_correction = CORRECTION_LOSS_WEIGHT * correction_surrogate\n",
        "            weighted_correction.backward()\n",
        "\n",
        "            corr_grad_raw = (\n",
        "                model.params.grad.detach().clone()\n",
        "                if model.params.grad is not None\n",
        "                else torch.zeros_like(model.params)\n",
        "            )\n",
        "            corr_grad_raw_norm = corr_grad_raw.norm().item()\n",
        "\n",
        "            # Pre-projection task/correction alignment.\n",
        "            denom_raw = task_grad_norm * corr_grad_raw_norm\n",
        "            if denom_raw > GRAD_NORM_EPS:\n",
        "                grad_cosine_pre = torch.dot(\n",
        "                    task_grad.reshape(-1), corr_grad_raw.reshape(-1)\n",
        "                ).item() / denom_raw\n",
        "            else:\n",
        "                grad_cosine_pre = 0.0\n",
        "\n",
        "            # If the correction gradient conflicts with the task gradient\n",
        "            # (negative cosine), remove ONLY its anti-task component. This is\n",
        "            # a PCGrad-like one-sided projection: the remaining correction is\n",
        "            # orthogonal to the task gradient rather than reversing task descent.\n",
        "            corr_grad_projected = corr_grad_raw.clone()\n",
        "            conflict_projected = False\n",
        "            projection_coeff = 0.0\n",
        "            if (\n",
        "                PROJECT_NEGATIVE_GRAD_CONFLICT\n",
        "                and task_grad_norm > GRAD_NORM_EPS\n",
        "                and corr_grad_raw_norm > GRAD_NORM_EPS\n",
        "                and grad_cosine_pre < 0.0\n",
        "            ):\n",
        "                task_sq = torch.sum(task_grad * task_grad)\n",
        "                projection_coeff_t = torch.sum(corr_grad_raw * task_grad) / (\n",
        "                    task_sq + GRAD_NORM_EPS\n",
        "                )\n",
        "                projection_coeff = projection_coeff_t.item()\n",
        "                corr_grad_projected = corr_grad_raw - projection_coeff_t * task_grad\n",
        "                conflict_projected = True\n",
        "\n",
        "            corr_grad_projected_norm = corr_grad_projected.norm().item()\n",
        "\n",
        "            # Gradient-relative normalization. The correction branch receives a\n",
        "            # controlled magnitude rho * ||g_task||, independent of the raw\n",
        "            # surrogate/Jacobian scale. Direction is preserved after projection.\n",
        "            # v9 confidence-adaptive normalization. The surrogate already uses component-wise\n",
        "            # confidence in its direction/magnitude; normalization used to erase that\n",
        "            # caution by always restoring the branch to rho_max*||g_task||. Preserve\n",
        "            # detector uncertainty by ramping rho with the mean calibration confidence.\n",
        "            detector_confidence = (\n",
        "                0.0 if (ORACLE_INJECTED_ERROR_CORRECTION and ORACLE_DISABLE_GRADIENT_CORRECTION)\n",
        "                else float(np.clip(probe_diag.get(\"mean_confidence\", 0.0), 0.0, 1.0))\n",
        "            )\n",
        "            effective_corr_ratio = (CORRECTION_GRAD_RATIO * detector_confidence\n",
        "                                    if CONFIDENCE_ADAPTIVE_GRADIENT else CORRECTION_GRAD_RATIO)\n",
        "            target_corr_norm = effective_corr_ratio * task_grad_norm\n",
        "            if corr_grad_projected_norm > GRAD_NORM_EPS and task_grad_norm > GRAD_NORM_EPS:\n",
        "                corr_scale = target_corr_norm / (corr_grad_projected_norm + GRAD_NORM_EPS)\n",
        "                corr_grad_applied = corr_grad_projected * corr_scale\n",
        "            else:\n",
        "                corr_scale = 0.0\n",
        "                corr_grad_applied = torch.zeros_like(corr_grad_projected)\n",
        "\n",
        "            corr_grad_applied_norm = corr_grad_applied.norm().item()\n",
        "\n",
        "            # Final optimizer gradient on quantum parameters.\n",
        "            combined_grad = task_grad + corr_grad_applied\n",
        "            model.params.grad.copy_(combined_grad)\n",
        "            combined_grad_norm = combined_grad.norm().item()\n",
        "\n",
        "            denom_post = task_grad_norm * corr_grad_applied_norm\n",
        "            if denom_post > GRAD_NORM_EPS:\n",
        "                grad_cosine_post = torch.dot(\n",
        "                    task_grad.reshape(-1), corr_grad_applied.reshape(-1)\n",
        "                ).item() / denom_post\n",
        "            else:\n",
        "                grad_cosine_post = 0.0\n",
        "\n",
        "            backward_time = time.perf_counter() - backward_start\n",
        "\n",
        "            print(\n",
        "                f\"    Backward          : {backward_time:.3f}s\",\n",
        "                flush=True\n",
        "            )\n",
        "            print(\n",
        "                f\"    Task grad norm    : {task_grad_norm:.6e}\",\n",
        "                flush=True\n",
        "            )\n",
        "            print(\n",
        "                f\"    Corr raw grad norm: {corr_grad_raw_norm:.6e} \"\n",
        "                f\"(surrogate weighted by λ={CORRECTION_LOSS_WEIGHT})\",\n",
        "                flush=True\n",
        "            )\n",
        "            print(\n",
        "                f\"    Grad cosine PRE   : {grad_cosine_pre:+.6f} \"\n",
        "                f\"(task vs raw correction)\",\n",
        "                flush=True\n",
        "            )\n",
        "            print(\n",
        "                f\"    Conflict projected: {conflict_projected} | \"\n",
        "                f\"projection coeff={projection_coeff:+.6e}\",\n",
        "                flush=True\n",
        "            )\n",
        "            print(\n",
        "                f\"    Corr projected norm: {corr_grad_projected_norm:.6e}\",\n",
        "                flush=True\n",
        "            )\n",
        "            print(\n",
        "                f\"    Corr target norm  : {target_corr_norm:.6e} \"\n",
        "                f\"(rho_eff={effective_corr_ratio:.5f}; rho_max={CORRECTION_GRAD_RATIO:.3f}; confidence={detector_confidence:.4f})\",\n",
        "                flush=True\n",
        "            )\n",
        "            print(\n",
        "                f\"    Corr grad scale   : {corr_scale:.6e}\",\n",
        "                flush=True\n",
        "            )\n",
        "            print(\n",
        "                f\"    Corr applied norm : {corr_grad_applied_norm:.6e}\",\n",
        "                flush=True\n",
        "            )\n",
        "            if corr_grad_applied_norm > GRAD_NORM_EPS:\n",
        "                print(\n",
        "                    f\"    Grad cosine POST  : {grad_cosine_post:+.6f} \"\n",
        "                    f\"(task vs applied correction)\",\n",
        "                    flush=True\n",
        "                )\n",
        "            print(\n",
        "                f\"    Combined grad norm: {combined_grad_norm:.6e}\",\n",
        "                flush=True\n",
        "            )\n",
        "            print(\n",
        "                f\"    Residual audit    : shotRMS={audit_diag['raw_rms']:.6f} | \"\n",
        "                f\"trajectoryRMS={audit_diag['trajectory_rms']:.6f} | \"\n",
        "                f\"correctionRMS={audit_diag['correction_rms']:.6f} | \"\n",
        "                f\"EMA(C)={audit_diag['ema_rms']:.6f}\",\n",
        "                flush=True\n",
        "            )\n",
        "            print(\n",
        "                f\"    QFT ΔXYZ RMS      : {audit_diag['qft_data_delta_rms']:.6f} | \"\n",
        "                f\"QFT ΔH RMS={audit_diag['qft_data_delta_h_rms']:.6f} | \"\n",
        "                f\"layer ΔXYZ RMS={audit_diag['layer_delta_h_rms']:.6f}\",\n",
        "                flush=True\n",
        "            )\n",
        "            print(\n",
        "                f\"    QFT preserve L01→L15: retention \"\n",
        "                f\"{audit_diag['retention_ratio'][0]:.4f}→{audit_diag['retention_ratio'][-1]:.4f} | \"\n",
        "                f\"alignment {audit_diag['direction_alignment'][0]:+.4f}→{audit_diag['direction_alignment'][-1]:+.4f} | \"\n",
        "                f\"projection {audit_diag['signal_projection'][0]:+.4f}→{audit_diag['signal_projection'][-1]:+.4f}\",\n",
        "                flush=True\n",
        "            )\n",
        "            print(\n",
        "                f\"    Correlation L01→L15: mean|XX| \"\n",
        "                f\"{np.mean(np.abs(audit_diag['xx_corr'][0])):.4f}→{np.mean(np.abs(audit_diag['xx_corr'][-1])):.4f} | \"\n",
        "                f\"mean|YY| {np.mean(np.abs(audit_diag['yy_corr'][0])):.4f}→{np.mean(np.abs(audit_diag['yy_corr'][-1])):.4f} | \"\n",
        "                f\"mean|ZZ| {np.mean(np.abs(audit_diag['zz_corr'][0])):.4f}→{np.mean(np.abs(audit_diag['zz_corr'][-1])):.4f}\",\n",
        "                flush=True\n",
        "            )\n",
        "\n",
        "            # -------------------------------------------------------\n",
        "            # COUNTERFACTUAL GRADIENT-STEP AUDIT (NO SHOTS)\n",
        "            # -------------------------------------------------------\n",
        "            # These are virtual first-order SGD-equivalent steps from the SAME\n",
        "            # theta and SAME learning rate. They do not mutate optimizer state.\n",
        "            # This isolates the marginal direction supplied by correction.\n",
        "            marginal_delta_g = 0.0\n",
        "            if AUDIT_COUNTERFACTUAL_GRADIENT_STEPS:\n",
        "                lr_cf = optimizer.param_groups[0][\"lr\"]\n",
        "                theta0 = model.params.detach().clone()\n",
        "                theta_task = theta0 - lr_cf * task_grad\n",
        "                theta_corr = theta0 - lr_cf * corr_grad_applied\n",
        "                theta_task_corr = theta0 - lr_cf * combined_grad\n",
        "                g0 = audit_diag[\"trajectory_rms\"]\n",
        "                g_task, _ = evaluate_same_sample_trajectory_rms(theta_task, batch_x[0], audit_diag)\n",
        "                g_corr, _ = evaluate_same_sample_trajectory_rms(theta_corr, batch_x[0], audit_diag)\n",
        "                g_task_corr, _ = evaluate_same_sample_trajectory_rms(theta_task_corr, batch_x[0], audit_diag)\n",
        "                marginal_delta_g = g_task_corr - g_task\n",
        "                helpful = marginal_delta_g < 0.0\n",
        "                print(\n",
        "                    f\"    Counterfactual G : base={g0:.6f} | task-only={g_task:.6f} | \"\n",
