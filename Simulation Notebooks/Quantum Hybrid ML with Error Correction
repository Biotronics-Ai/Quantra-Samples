        "# =====================================================================\n",
        "# 11. CLASSIFIER CIRCUIT\n",
        "#\n",
        "# IMPORTANT:\n",
        "#   Forward state is NEVER rotated by M-E. This preserves the input/QFT\n",
        "#   induced state trajectory. The stochastic one-shot residual is handled\n",
        "#   only as a backward-side auxiliary signal.\n",
        "# =====================================================================\n",
        "\n",
        "@qml.qnode(\n",
        "    quantum_dev,\n",
        "    interface=\"torch\",\n",
        "    diff_method=\"adjoint\"\n",
        ")\n",
        "def quantum_classifier_single(params, sample_input):\n",
        "\n",
        "    build_qft_variational_circuit(\n",
        "        params=params,\n",
        "        sample_input=sample_input,\n",
        "        n_completed_layers=n_layers,\n",
        "        differentials=None,\n",
        "        lr_correction=0.0,\n",
        "        apply_correction=False\n",
        "    )\n",
        "\n",
        "    return [qml.expval(qml.PauliZ(q)) for q in range(n_qubits)]\n",
        "\n",
        "\n",
        "# =====================================================================\n",
        "# 12. BATCH QUANTUM FORWARD\n",
        "# =====================================================================\n",
        "\n",
        "def quantum_batch_forward(params, batch_x, verbose=False):\n",
        "\n",
        "    outputs = []\n",
        "\n",
        "    for sample_idx in range(batch_x.shape[0]):\n",
        "        if verbose:\n",
        "            print(\n",
        "                f\"        Quantum sample {sample_idx + 1}/{batch_x.shape[0]}\",\n",
        "                flush=True\n",
        "            )\n",
        "\n",
        "        result = quantum_classifier_single(params, batch_x[sample_idx])\n",
        "\n",
        "        if isinstance(result, torch.Tensor):\n",
        "            tensor_result = result\n",
        "        else:\n",
        "            tensor_result = torch.stack(list(result))\n",
        "\n",
        "        outputs.append(\n",
        "            tensor_result.to(device=batch_x.device, dtype=torch.float64)\n",
        "        )\n",
        "\n",
        "    return torch.stack(outputs, dim=0)\n",
        "\n",
        "\n",
        "# =====================================================================\n",
        "# 12B. SINGLE-SHOT RESIDUAL MONITOR FOR BACKWARD-SIDE CORRECTION\n",
        "#\n",
        "# We deliberately DO NOT inject RX/RY/RZ correction gates into the next\n",
        "# layer. For a small monitoring subset, every layer is observed with:\n",
        "#   E_lqa = analytic expectation\n",
        "#   M_lqa = strict one-shot outcome\n",
        "#   r_lqa = M_lqa - E_lqa\n",
        "# The residual is accumulated with EMA. This keeps shots=1 per execution\n",
        "# while preventing one random shot from dominating an optimizer step.\n",
        "#\n",
        "# NOTE: the raw one-shot target is detached/non-differentiable. The EMA\n",
        "# residual is therefore a control/regularization signal, not a gradient\n",
        "# through the physical measurement itself.\n",
        "# =====================================================================\n",
        "\n",
        "class ResidualEMA:\n",
        "    def __init__(self, beta=RESIDUAL_EMA_BETA):\n",
        "        self.beta = float(beta)\n",
        "        self.value = np.zeros((n_layers, 3, n_qubits), dtype=np.float64)\n",
        "        self.initialized = False\n",
        "\n",
        "    def update(self, residual):\n",
        "        residual = np.asarray(residual, dtype=np.float64)\n",
        "        if not self.initialized:\n",
        "            self.value[...] = residual\n",
        "            self.initialized = True\n",
        "        else:\n",
        "            self.value[...] = self.beta * self.value + (1.0 - self.beta) * residual\n",
        "        return self.value.copy()\n",
        "\n",
        "\n",
        "residual_ema = ResidualEMA()\n",
        "\n",
        "\n",
        "class StandardizedBiasEMA:\n",
        "    def __init__(self, beta=RESIDUAL_EMA_BETA):\n",
        "        self.beta = float(beta)\n",
        "        self.value = np.zeros((n_layers, 3, n_qubits), dtype=np.float64)\n",
        "        self.initialized = False\n",
        "\n",
        "    def update(self, z):\n",
        "        z = np.asarray(z, dtype=np.float64)\n",
        "        if not self.initialized:\n",
        "            # Start from zero rather than copying the first random one-shot.\n",
        "            self.value[...] = (1.0 - self.beta) * z\n",
        "            self.initialized = True\n",
        "        else:\n",
        "            self.value[...] = self.beta * self.value + (1.0 - self.beta) * z\n",
        "        return self.value.copy()\n",
        "\n",
        "\n",
        "bias_z_ema = StandardizedBiasEMA()\n",
        "\n",
        "class CalibrationProbeMoments:\n",
        "    \"\"\"Per-probe/component running mean of raw one-shot residuals.\n",
        "\n",
        "    v8 deliberately does NOT estimate variance from 2-3 shots.  Significance\n",
        "    uses Var(M|E_clean)=1-E_clean^2 analytically, preventing zero-variance\n",
        "    explosions when repeated +/-1 outcomes happen to match.\n",
        "    \"\"\"\n",
        "    def __init__(self, n_probes):\n",
        "        shape = (n_probes, n_layers, 3, n_qubits)\n",
        "        self.count = np.zeros((n_probes, 1, 1, 1), dtype=np.int64)\n",
        "        self.mean_residual = np.zeros(shape, dtype=np.float64)\n",
        "\n",
        "    def update_probe(self, probe_idx, residual):\n",
        "        residual = np.asarray(residual, dtype=np.float64)\n",
        "        n_old = int(self.count[probe_idx,0,0,0])\n",
        "        n_new = n_old + 1\n",
        "        self.mean_residual[probe_idx] += (residual - self.mean_residual[probe_idx]) / n_new\n",
        "        self.count[probe_idx,0,0,0] = n_new\n",
        "\n",
        "    def stats(self, clean_expectation):\n",
        "        clean = np.asarray(clean_expectation, dtype=np.float64)\n",
        "        n = np.maximum(self.count.astype(np.float64), 1.0)\n",
        "        # Exact null variance for a +/-1 Pauli observation with mean E_clean.\n",
        "        var_null = np.maximum(1.0 - clean**2, THEORETICAL_SIGMA_FLOOR**2)\n",
        "        se = np.sqrt(var_null / n)\n",
        "        zsig = self.mean_residual / np.maximum(se, 1e-9)\n",
        "        return self.mean_residual.copy(), se, zsig, self.count.copy()\n",
        "\n",
        "\n",
        "class QFTAwarePooledBiasEstimator:\n",
        "    \"\"\"Small shared per-axis bias model using QFT context.\n",
        "\n",
        "    Features = [1, E_clean, D_QFT, E_clean*D_QFT].  D_QFT is the displacement\n",
        "    caused by input encoding + QFT relative to a zero-input QFT reference.\n",
        "    It is a conditioning variable, NOT an error: E_clean already contains QFT.\n",
        "    Pooling across probes/layers/qubits lets many one-shot observations estimate\n",
        "    a few persistent device-error coefficients.\n",
        "    \"\"\"\n",
        "    def __init__(self):\n",
        "        self.xtx = np.zeros((3,4,4), dtype=np.float64)\n",
        "        self.xty = np.zeros((3,4), dtype=np.float64)\n",
        "        self.n_batches = 0\n",
        "\n",
        "    @staticmethod\n",
        "    def features(clean_axis, dqft_axis):\n",
        "        e=np.asarray(clean_axis,dtype=np.float64).reshape(-1)\n",
        "        d=np.asarray(dqft_axis,dtype=np.float64).reshape(-1)\n",
        "        return np.stack([np.ones_like(e), e, d, e*d], axis=1)\n",
        "\n",
        "    def update(self, clean, dqft, measured):\n",
        "        residual=np.asarray(measured)-np.asarray(clean)\n",
        "        for a in range(3):\n",
        "            X=self.features(clean[:,:,a,:], dqft[:,:,a,:])\n",
        "            y=residual[:,:,a,:].reshape(-1)\n",
        "            self.xtx[a] += X.T @ X\n",
        "            self.xty[a] += X.T @ y\n",
        "        self.n_batches += 1\n",
        "\n",
        "    def coefficients(self):\n",
        "        out=np.zeros((3,4),dtype=np.float64)\n",
        "        eye=np.eye(4,dtype=np.float64)\n",
        "        for a in range(3):\n",
        "            out[a]=np.linalg.solve(self.xtx[a] + QFT_POOL_RIDGE*eye, self.xty[a])\n",
        "        return out\n",
        "\n",
        "    def predict(self, clean, dqft):\n",
        "        coef=self.coefficients()\n",
        "        pred=np.zeros_like(clean,dtype=np.float64)\n",
        "        for a in range(3):\n",
        "            X=self.features(clean[:,:,a,:], dqft[:,:,a,:])\n",
        "            pred[:,:,a,:]=(X @ coef[a]).reshape(clean.shape[0],clean.shape[1],clean.shape[3])\n",
        "        return pred, coef\n",
        "\n",
        "calibration_moments = CalibrationProbeMoments(CALIBRATION_PROBE_COUNT)\n",
        "qft_pooled_bias = QFTAwarePooledBiasEstimator()\n",
        "_noise_rng = np.random.default_rng(SEED + 2026)\n",
        "\n",
        "\n",
        "def _noise_params_for_mode(mode=None):\n",
        "    mode = NOISE_ABLATION_MODE if mode is None else str(mode).lower()\n",
        "    if mode == \"zero\": return 0.0, 0.0, 0.0\n",
        "    if mode == \"readout\": return NOISE_READOUT_FLIP_P, 0.0, 0.0\n",
        "    if mode == \"depolarizing\": return 0.0, NOISE_DEPOLARIZING_P, 0.0\n",
        "    if mode == \"coherent\": return 0.0, 0.0, NOISE_COHERENT_RY_RAD\n",
        "    if mode == \"combined\": return NOISE_READOUT_FLIP_P, NOISE_DEPOLARIZING_P, NOISE_COHERENT_RY_RAD\n",
        "    raise ValueError(f\"Unknown NOISE_ABLATION_MODE={mode!r}\")\n",
        "\n",
        "\n",
        "def apply_controlled_noise_to_xyz(clean_xyz, mode=None):\n",
        "    \"\"\"Return known noisy expectation under a controlled local noise model.\n",
        "\n",
        "    Model order: coherent RY over-rotation -> isotropic Bloch shrinkage used as\n",
        "    a depolarizing surrogate -> symmetric readout sign-flip attenuation.\n",
        "    This is intentionally transparent and analytically auditable.\n",
        "    \"\"\"\n",
        "    clean = np.asarray(clean_xyz, dtype=np.float64)\n",
        "    x, y, z = clean[0], clean[1], clean[2]\n",
        "    readout_p, depol_p, coherent_ry = _noise_params_for_mode(mode)\n",
        "    th = float(coherent_ry)\n",
        "    # Bloch-vector action of RY(th).\n",
        "    xr = np.cos(th) * x + np.sin(th) * z\n",
        "    yr = y\n",
        "    zr = -np.sin(th) * x + np.cos(th) * z\n",
        "    noisy = np.stack([xr, yr, zr], axis=0)\n",
        "    noisy *= (1.0 - float(depol_p))\n",
        "    noisy *= (1.0 - 2.0 * float(readout_p))\n",
        "    return np.clip(noisy, -1.0, 1.0)\n",
        "\n",
        "\n",
        "def sample_one_shot_xyz_from_expectation(expectation):\n",
        "    \"\"\"Independent one-shot Pauli-setting samples, values in {-1,+1}.\"\"\"\n",
        "    e = np.clip(np.asarray(expectation, dtype=np.float64), -1.0, 1.0)\n",
        "    p_plus = 0.5 * (1.0 + e)\n",
        "    u = _noise_rng.random(e.shape)\n",
        "    return np.where(u < p_plus, 1.0, -1.0)\n",
        "\n",
        "\n",
        "def _xyz_exact(params_cpu, input_cpu, completed_layers, dummy):\n",
        "    return parse_xyz_output(\n",
        "        analytic_expected_xyz_qnode(\n",
        "            params_cpu, input_cpu, completed_layers,\n",
        "            dummy, 0.0, False\n",
        "        )\n",
        "    )\n",
        "\n",
        "\n",
        "def _xyz_shot(params_cpu, input_cpu, completed_layers, dummy):\n",
        "    return parse_xyz_output(\n",
        "        strict_1shot_xyz_qnode(\n",
        "            params_cpu, input_cpu, completed_layers,\n",
        "            dummy, 0.0, False\n",
        "        )\n",
        "    )\n",
        "\n",
        "\n",
        "def _xyz_context_noisy_exact(params_cpu, input_cpu, completed_layers):\n",
        "    return parse_xyz_output(contextual_noisy_xyz_qnode(params_cpu, input_cpu, completed_layers))\n",
        "\n",
        "def _xyz_context_noisy_shot(params_cpu, input_cpu, completed_layers):\n",
        "    return parse_xyz_output(contextual_noisy_1shot_xyz_qnode(params_cpu, input_cpu, completed_layers))\n",
        "\n",
        "\n",
        "def collect_calibration_probe_control(params, calibration_probes, verbose=True):\n",
        "    \"\"\"v13 deterministic QFT-reference residual correction.\n",
        "\n",
        "    No learned bias, EMA, significance gate, minimum observations, or access to\n",
        "    injected-noise parameters is used to construct the correction.\n",
        "\n",
        "    For each probe/layer/axis/qubit:\n",
        "      D_QFT(x)      = E_QFT(x) - E_QFT(x_ref)\n",
        "      E_expected_l  = E_l(x_ref) + D_QFT(x)\n",
        "      residual      = M_l(x) - E_expected_l\n",
        "      M_corrected   = M_l(x) - residual = E_expected_l\n",
        "\n",
        "    Thus the precomputed QFT displacement is retained by construction and every\n",
        "    deviation from that declared reference is removed immediately. Ground-truth\n",
        "    clean/noisy expectations below are evaluator-only diagnostics.\n",
        "    \"\"\"\n",
        "    params_cpu = params.detach().cpu().to(torch.float64)\n",
        "    dummy = np.zeros((n_layers, 3, n_qubits), dtype=np.float64)\n",
        "    P = len(calibration_probes)\n",
        "    expected = np.zeros((P,n_layers,3,n_qubits), dtype=np.float64)\n",
        "    clean = np.zeros_like(expected)\n",
        "    noisy = np.zeros_like(expected)\n",
        "    measured = np.zeros_like(expected)\n",
        "    corrected = np.zeros_like(expected)\n",
        "    residual = np.zeros_like(expected)\n",
        "    dqft = np.zeros_like(expected)\n",
        "    reference_input = torch.zeros_like(calibration_probes[0]).detach().cpu().to(torch.float64)\n",
        "    qft_ref = _xyz_exact(params_cpu, reference_input, 0, dummy)\n",
        "    ref_layers = np.stack([_xyz_exact(params_cpu, reference_input, l+1, dummy) for l in range(n_layers)])\n",
        "\n",
        "    for pidx, probe in enumerate(calibration_probes):\n",
        "        probe_cpu = probe.detach().cpu().to(torch.float64)\n",
        "        qft_data = _xyz_exact(params_cpu, probe_cpu, 0, dummy)\n",
        "        d = qft_data - qft_ref\n",
        "        dqft[pidx] = d[None,:,:]\n",
        "        base_expected = ref_layers + d[None,:,:]\n",
        "        for layer_idx in range(n_layers):\n",
        "            e = _xyz_exact(params_cpu, probe_cpu, layer_idx+1, dummy)\n",
        "            clean[pidx,layer_idx] = e\n",
        "            # Full contextual circuit evolution: every completed layer already\n",
        "            # contains the propagated effect of all preceding layers, entanglers,\n",
        "            # parameters, input encoding and QFT.  The legitimate contextual term\n",
        "            # closes the gap left by the old fixed-D_QFT reference.\n",
        "            contextual_evolution = e - base_expected[layer_idx]\n",
        "            expected[pidx,layer_idx] = base_expected[layer_idx] + contextual_evolution\n",
        "            noisy[pidx,layer_idx] = _xyz_context_noisy_exact(params_cpu, probe_cpu, layer_idx+1) if INJECT_CONTROLLED_NOISE else e\n",
        "            measured[pidx,layer_idx] = _xyz_context_noisy_shot(params_cpu, probe_cpu, layer_idx+1) if INJECT_CONTROLLED_NOISE else _xyz_shot(params_cpu, probe_cpu, layer_idx+1, dummy)\n",
        "        residual[pidx] = measured[pidx] - expected[pidx]\n",
        "        corrected[pidx] = measured[pidx] - residual[pidx]\n",
        "\n",
        "    # Immediate correction control: no waiting and no statistical confidence gate.\n",
        "    mean_control = np.mean(-residual, axis=0)\n",
        "    confidence = np.ones_like(residual)\n",
        "\n",
        "    # Evaluator-only metrics. They do not feed the correction above.\n",
        "    true_bias = noisy-clean\n",
        "    noisy_mae = float(np.mean(np.abs(measured-expected)))\n",
        "    corrected_mae = float(np.mean(np.abs(corrected-expected)))\n",
        "    recovery = 100.0*(noisy_mae-corrected_mae)/(noisy_mae+1e-12)\n",
        "    target_identity = float(np.max(np.abs(corrected-expected)))\n",
        "    clean_reference_gap = float(np.mean(np.abs(clean-expected)))\n",
        "    diag=dict(noisy_mae=noisy_mae, corrected_mae=corrected_mae, recovery_pct=recovery,\n",
        "              active_fraction=1.0, mean_confidence=1.0, sign_accuracy=float('nan'),\n",
        "              bias_correlation=float('nan'), observations=1, mean_abs_significance=float('nan'),\n",
        "              max_abs_significance=float('nan'), component_mean_abs_z=float('nan'),\n",
        "              bias_estimate_mae=float('nan'), learned_bias_estimate_mae=float('nan'),\n",
        "              learned_bias_correlation=float('nan'), true_bias_rms=float(np.sqrt(np.mean(true_bias**2))),\n",
        "              estimate_rms=float(np.sqrt(np.mean(residual**2))), qft_displacement_rms=float(np.sqrt(np.mean(dqft**2))),\n",
        "              pooled_batches=1, pooled_coefficients=np.zeros((3,4)), oracle_mode=False,\n",
        "              deterministic_reference_mode=True, target_identity_max_abs=target_identity,\n",
        "              clean_reference_gap_mae=clean_reference_gap)\n",
        "    if verbose:\n",
        "        print(\"\\n[v17 CONTEXTUAL EXPECTED + CONTEXT-PROPAGATING RANDOM NOISE]\", flush=True)\n",
        "        print(\"    noise injection: ON | heterogeneous RX/RY/RZ map per (layer,qubit) | errors propagate through later layers\", flush=True)\n",
        "        print(f\"    random map seed={RANDOM_NOISE_SEED} | RX range=[{CONTEXT_RX_ERROR.min():+.4f},{CONTEXT_RX_ERROR.max():+.4f}] rad | RY=[{CONTEXT_RY_ERROR.min():+.4f},{CONTEXT_RY_ERROR.max():+.4f}] | RZ=[{CONTEXT_RZ_ERROR.min():+.4f},{CONTEXT_RZ_ERROR.max():+.4f}]\", flush=True)\n",
        "        print(f\"    QFT displacement RMS={diag['qft_displacement_rms']:.6f} (preserved reference component)\", flush=True)\n",
        "        print(f\"    measured→expected MAE={noisy_mae:.6e} | corrected→expected MAE={corrected_mae:.6e} | reference recovery={recovery:+.3f}%\", flush=True)\n",
        "        print(f\"    max|corrected-expected|={target_identity:.3e} | confidence=1.0000 | active=1.000\", flush=True)\n",
        "        print(f\"    clean-vs-full-context-expected MAE={clean_reference_gap:.6e} (ideal contextual model identity)\", flush=True)\n",
        "        print(\"    expected = full clean circuit prefix F_l(QFT(RX(x)), theta_1..l); residual = measured - expected\", flush=True)\n",
        "        print(\"    injected NOISE_* parameters are NOT read by expected-value estimation/correction\", flush=True)\n",
        "        print(\"    expected trajectory is propagated independently through the full clean circuit prefix\", flush=True)\n",
        "    return mean_control,diag\n",
        "\n",
        "def backward_probe_bias_surrogate(params, calibration_probes, mean_control, batch_idx=0):\n",
        "    \"\"\"Differentiable correction surrogate.\n",
        "\n",
        "    v7 fast mode keeps the *detector* full-resolution but subsamples the costly\n",
        "    adjoint-gradient estimator: one rotating fixed probe and L01/L05/L10/L15.\n",
        "    This changes compute, not the measured calibration target.  Across batches\n",
        "    all probes rotate through the estimator.\n",
        "    \"\"\"\n",
        "    control_t = torch.as_tensor(mean_control, dtype=params.dtype, device=params.device)\n",
        "    dummy = np.zeros((n_layers, 3, n_qubits), dtype=np.float64)\n",
        "    terms=[]\n",
        "\n",
        "    if FAST_VALIDATION_MODE:\n",
        "        nprobe = len(calibration_probes)\n",
        "        k = min(FAST_CORRECTION_PROBES_PER_BATCH, nprobe)\n",
        "        start = int(batch_idx) % nprobe\n",
        "        probe_ids = [(start + j) % nprobe for j in range(k)]\n",
        "        layer_ids = [int(i) for i in FAST_CORRECTION_LAYER_INDICES]\n",
        "    else:\n",
        "        probe_ids = list(range(len(calibration_probes)))\n",
        "        layer_ids = list(range(n_layers))\n",
        "\n",
        "    for pidx in probe_ids:\n",
        "        probe_dev = calibration_probes[pidx].to(device=params.device, dtype=params.dtype)\n",
        "        for layer_idx in layer_ids:\n",
        "            result = analytic_expected_xyz_qnode(params, probe_dev, layer_idx+1, dummy, 0.0, False)\n",
        "            e = result.reshape(3, n_qubits) if isinstance(result, torch.Tensor) else torch.stack(list(result)).reshape(3, n_qubits)\n",
        "            centered = e - e.detach()\n",
        "            terms.append((centered * control_t[layer_idx]).mean())\n",
        "    return torch.stack(terms).mean() if terms else params.sum()*0.0\n",
        "\n",
        "\n",
        "def collect_single_shot_residual(params, sample_input, verbose=False):\n",
        "    \"\"\"\n",
        "    QFT-CONDITIONED CORRECTION REFERENCE\n",
        "    -----------------------------------\n",
        "    For input x and reference x_ref=0:\n",
        "\n",
        "      D_QFT        = E_QFT(x) - E_QFT(x_ref)\n",
        "      E_ref_layer  = E_l(x_ref)\n",
        "      E_target_l   = E_ref_layer + D_QFT\n",
        "\n",
        "    E_target is therefore NOT E_l(x) + D_QFT (which would double-count\n",
        "    the data contribution). It asks: \"what would this layer's reference\n",
        "    Hamiltonian/Bloch value be if the input-induced QFT displacement were\n",
        "    preserved?\"\n",
        "\n",
        "    We then keep three residuals separate:\n",
        "\n",
        "      shot residual       S_l = M_l(x) - E_l(x)\n",
        "      trajectory residual G_l = E_l(x) - E_target_l\n",
        "      correction residual C_l = M_l(x) - E_target_l = S_l + G_l\n",
        "\n",
        "    Only C_l is accumulated by EMA and used to shape the backward-side\n",
        "    correction gradient. No correction gate is inserted into the forward\n",
        "    quantum state.\n",
        "    \"\"\"\n",
        "    actual_expected = np.zeros((n_layers, 3, n_qubits), dtype=np.float64)\n",
        "    measured_all = np.zeros_like(actual_expected)\n",
        "    noisy_expected_all = np.zeros_like(actual_expected)\n",
        "    reference_layer = np.zeros_like(actual_expected)\n",
        "\n",
        "    params_cpu = params.detach().cpu().to(torch.float64)\n",
        "    sample_cpu = sample_input.detach().cpu().to(torch.float64)\n",
        "    reference_input = torch.zeros_like(sample_cpu)\n",
        "    dummy = np.zeros((n_layers, 3, n_qubits), dtype=np.float64)\n",
        "\n",
        "    # Post-QFT, before variational layers.\n",
        "    qft_data = _xyz_exact(params_cpu, sample_cpu, 0, dummy)\n",
        "    qft_reference = _xyz_exact(params_cpu, reference_input, 0, dummy)\n",
        "    qft_data_displacement = qft_data - qft_reference\n",
        "\n",
        "    for layer_idx in range(n_layers):\n",
        "        completed = layer_idx + 1\n",
        "        actual_expected[layer_idx] = _xyz_exact(\n",
        "            params_cpu, sample_cpu, completed, dummy\n",
        "        )\n",
        "        if INJECT_CONTROLLED_NOISE:\n",
        "            # v15: execute a genuinely different circuit prefix containing all\n",
        "            # heterogeneous errors from layers 1..completed.  Earlier errors\n",
        "            # therefore propagate through every subsequent unitary/entangler.\n",
        "            noisy_expected_all[layer_idx] = _xyz_context_noisy_exact(\n",
        "                params_cpu, sample_cpu, completed\n",
        "            )\n",
        "            measured_all[layer_idx] = _xyz_context_noisy_shot(\n",
        "                params_cpu, sample_cpu, completed\n",
        "            )\n",
        "        else:\n",
        "            noisy_expected_all[layer_idx] = actual_expected[layer_idx]\n",
        "            measured_all[layer_idx] = _xyz_shot(\n",
        "                params_cpu, sample_cpu, completed, dummy\n",
        "            )\n",
        "        reference_layer[layer_idx] = _xyz_exact(\n",
        "            params_cpu, reference_input, completed, dummy\n",
        "        )\n",
        "\n",
        "    # v17 CONTEXTUAL EXPECTED-VALUE ESTIMATION.\n",
        "    # Build the expected trajectory independently by executing the complete\n",
        "    # CLEAN prefix 1..l for every layer.  Thus L_l expectation contains the\n",
        "    # contextual influence of QFT and all earlier variational layers.\n",
        "    # No injected RX/RY/RZ noise-map value is read by this estimator.\n",
        "    qft_base_expected = reference_layer + qft_data_displacement[None, :, :]\n",
        "    qft_conditioned_expected = np.zeros_like(actual_expected)\n",
        "    for layer_idx in range(n_layers):\n",
        "        qft_conditioned_expected[layer_idx] = _xyz_exact(\n",
        "            params_cpu, sample_cpu, layer_idx + 1, dummy\n",
        "        )\n",
        "    legitimate_contextual_evolution = qft_conditioned_expected - qft_base_expected\n",
        "\n",
        "    # v16 PHYSICALLY SEPARATED RESIDUALS.\n",
        "    # ideal_context_residual verifies the clean full-context model itself.\n",
        "    # hardware_residual is the context-propagated displacement caused ONLY by\n",
        "    # the heterogeneous in-circuit RX/RY/RZ error map.\n",
        "    # shot_residual is one-shot projection randomness around the NOISY state.\n",
        "    # total_residual is what the noisy one-shot measurement shows relative to\n",
        "    # the ideal full-context expectation.\n",
        "    ideal_context_residual = actual_expected - qft_conditioned_expected\n",
        "    hardware_residual = noisy_expected_all - actual_expected\n",
        "    shot_residual = measured_all - noisy_expected_all\n",
        "    total_residual = measured_all - actual_expected\n",
        "\n",
        "    # Compatibility names used elsewhere in the legacy audit.  G now means\n",
        "    # only clean-model mismatch (expected ~0), while C is the total measured\n",
        "    # residual relative to the ideal trajectory.\n",
        "    trajectory_residual = ideal_context_residual\n",
        "    correction_residual = total_residual\n",
        "\n",
        "    # Physical decomposition: M_noisy - E_ideal =\n",
        "    # (E_noisy - E_ideal) + (M_noisy - E_noisy).\n",
        "    decomposition_error = total_residual - (hardware_residual + shot_residual)\n",
        "\n",
        "    # v13: immediate deterministic reference-residual correction. No EMA, no\n",
        "    # minimum observations, no significance threshold, and no injected-noise\n",
        "    # parameter is consulted. The declared expected value is the precomputed\n",
        "    # reference-layer expectation plus the input-specific QFT displacement.\n",
        "    ideal_sigma = np.sqrt(np.clip(1.0 - noisy_expected_all ** 2, 1e-9, None))\n",
        "    standardized_residual = correction_residual / ideal_sigma\n",
        "    ema_z = standardized_residual.copy()\n",
        "    confidence = np.ones_like(correction_residual)\n",
        "    persistent_bias_estimate = correction_residual.copy()\n",
        "    correction_control = -correction_residual\n",
        "\n",
        "    # Ground truth remains evaluation-only. It is not used above.\n",
        "    true_injected_bias = noisy_expected_all - actual_expected\n",
        "    ema = correction_control\n",
        "    corrected_measured = measured_all - correction_residual\n",
